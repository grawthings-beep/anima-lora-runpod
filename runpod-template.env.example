WORKSPACE_DIR=/workspace/anima-lora
MODEL_ROOT=/workspace/anima-lora
DOWNLOAD_MODELS=1
RUN_DEP_CHECK=1
AUTO_TRAIN=0
# --- JupyterLab (browse files + view sample images in-browser) ---
# Expose port 8888 (HTTP) in the RunPod template to reach it.
ENABLE_JUPYTER=1
JUPYTER_PORT=8888
# Empty = no login token. Set a value to require it (recommended on public pods).
JUPYTER_TOKEN=
HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}
CIVITAI_TOKEN={{ RUNPOD_SECRET_CIVITAI_TOKEN }}
ARIA2_CONNECTIONS=16
ARIA2_SPLITS=16
DATASET_REPEAT=50
LEARNING_RATE=1e-4
NUM_EPOCHS=5
LORA_RANK=32
MAX_PIXELS=1048576
SAVE_STEPS=500
